        // Target the specific span class
        $('.dokan-vendor-rating').each(function() {
            var $span = $(this);
            var ratingText = $span.text().trim();
            var rating = parseFloat(ratingText);
            
            // Check if it's a valid number and hasn't been processed yet
            if (!isNaN(rating) && $span.find('.fa-star').length === 0) {
                var starsHtml = '';
                
                // Generate 5 stars
                for (var i = 1; i <= 5; i++) {
                    if (rating >= i) {
                        // Full Star
                        starsHtml += '<i class="fa fa-star" style="color:#ffb300; margin-right:2px;"></i>';
                    } else if (rating >= i - 0.5) {
                        // Half Star
                        starsHtml += '<i class="fa fa-star-half-o" style="color:#ffb300; margin-right:2px;"></i>';
                    } else {
                        // Empty Star
                        starsHtml += '<i class="fa fa-star-o" style="color:#e1e1e1; margin-right:2px;"></i>';
                    }
                }
                
                // Update the HTML: Stars followed by the number
                $span.html(starsHtml + ' <span style="color:#6b7280; font-weight:600; margin-left:4px; font-size: 0.9em;">' + ratingText + '</span>');
            }
        });
    });
